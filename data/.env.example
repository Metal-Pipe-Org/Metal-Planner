# =========================
# Metal Planner - zmienne srodowiskowe (szablon)
# =========================
#
# Skopiuj ten plik na .env i uzupelnij wartosci:
#     cp data/.env.example data/.env
#
# .env trafia do .gitignore i NIE moze byc commitowany - trzymaj w nim
# prawdziwe sekrety. Tutaj (w .env.example) zostawiaj wylacznie puste
# miejsca i przyklady, bo ten plik jest w repozytorium.
#
# Plik .env wczytuje config.py przy starcie aplikacji - nie trzeba go
# nigdzie podawac. Zmienne ustawione juz w srodowisku (np. przez
# `environment:` w docker-compose.yml) maja pierwszenstwo nad tym plikiem.

# -------------------------
PKP_API_KEY=

# -------------------------
# Propozycje tras konczace sie autem Traficar (patrz traficar.py). Auta bierze
# sie z fioletowe.live - to STRONA TRZECIA, nie sam Traficar, wiec feed moze
# zniknac albo zmienic ksztalt bez ostrzezenia. Domyslnie wlaczone; TRAFICAR=0
# gasi te propozycje bez zmiany kodu. Klucza nie trzeba.
TRAFICAR=1

# -------------------------
# Tryb deweloperski. DEV_MODE=1 pokazuje w ustawieniach (⚙) sekcje ze
# znaczkiem DEV i dokłada w karcie "O aplikacji" (klik w ikonę) linki zespołu:
# issues i obie wersje aplikacji. Bez tego wpisu - jak na produkcji -
# aplikacja pokazuje tylko to, co dla wszystkich, a schowane ustawienia
# wracają do domyślnych.
DEV_MODE=

# -------------------------
# Odblokowanie wgrywania rozkladu Siechnic kodem z Discorda (DEV_MODE=1): zanim
# karta przegladarki wgra rozklad, wysyla sie kod na kanal z pingiem wybranej
# osoby. Bez DISCORD albo bez data/discord.json wgrywanie zostaje zablokowane.
# DISCORD - adres webhooka kanalu (SEKRET, tylko w prawdziwym .env).
# Osoby do pingu - plik data/discord.json (poza repo), JSON z loginow GitHuba
# na ID z Discorda jak zmienna repo w .github/workflows/discord.yml,
# np. {"login": "123456789012345678"}.
DISCORD=
