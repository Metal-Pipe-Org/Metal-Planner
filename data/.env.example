# =========================
# Metal Planner - zmienne srodowiskowe (szablon)
# =========================
#
# Skopiuj ten plik na .env i uzupelnij wartosci:
#     cp data/.env.example data/.env
#
# .env trafia do .gitignore i NIE moze byc commitowany - trzymaj w nim
# prawdziwe sekrety. Tutaj (w .env.example) zostawiaj wylacznie puste
# miejsca i przyklady, bo ten plik jest w repozytorium.
#
# Plik .env wczytuje config.py przy starcie aplikacji - nie trzeba go
# nigdzie podawac. Zmienne ustawione juz w srodowisku (np. przez
# `environment:` w docker-compose.yml) maja pierwszenstwo nad tym plikiem.

# -------------------------
PKP_API_KEY=

# Ile odjazdow pokazuje dymek pod kropka przesiadki na mapie.
# Puste = 8. Sufit to 20 - wiekszy dymek zaslania mape, o ktora sie pyta.
TIMETABLE_ROWS=
